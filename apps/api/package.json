{
  "name": "@solid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test",
    "auth:bootstrap": "node dist/src/bootstrap-admin.js",
    "auth:reset-password": "node dist/src/reset-admin-password.js",
    "auth:promote-owner": "node dist/src/promote-store-owner.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "10.3.0",
    "@solid/config": "0.1.0",
    "@solid/contracts": "0.1.0",
    "@solid/database": "0.1.0",
    "fastify": "5.12.0",
    "fastify-raw-body": "6.0.1",
    "sharp": "0.35.3",
    "stripe": "22.6.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4"
  }
}
