generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum StoreRole {
  OWNER
  ADMIN
  ANALYST
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum ProductSource {
  MANUAL
  SHOPIFY
}

enum CheckoutStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CheckoutSessionStatus {
  OPEN
  EXPIRED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
}

enum DeliveryJobStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD
}

enum BillingPlan {
  START
  PRIME
  ELITE
}

enum BillingSubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  UNPAID
  CANCELED
  INCOMPLETE
}

enum BillingEntryType {
  TRANSACTION_FEE
  REFUND_CREDIT
}

enum BillingPaymentProvider {
  STRIPE
  ROAS
}

enum BillingPixStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum ProductFeedbackType {
  SUGGESTION
  BUG
}

enum ProductFeedbackStatus {
  BACKLOG
  PLANNED
  IN_PROGRESS
  DONE
}

enum ProductReleaseCategory {
  NEWS
  IMPROVEMENT
  FIX
  INTEGRATION
  SECURITY
}

enum ChromaSenseEventType {
  VIEW
  CLICK
  MOVE
  SCROLL
  ATTENTION
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  publicId        String        @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  email           String        @unique @db.VarChar(320)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  name            String        @db.VarChar(120)
  passwordHash    String?       @map("password_hash") @db.VarChar(255)
  disabledAt      DateTime?     @map("disabled_at") @db.Timestamptz(3)
  accountStatus   AccountStatus @default(PENDING) @map("account_status")
  platformAdmin   Boolean       @default(false) @map("platform_admin")
  profile         Json?
  profileEncrypted String?      @map("profile_encrypted") @db.Text
  mfaSecretEncrypted String?    @map("mfa_secret_encrypted") @db.Text
  mfaPendingSecretEncrypted String? @map("mfa_pending_secret_encrypted") @db.Text
  mfaEnabledAt    DateTime?     @map("mfa_enabled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships     StoreMember[]
  sessions        Session[]
  auditLogs       AuditLog[]
  shopifyOAuthStates ShopifyOAuthState[]
  notificationStates NotificationState[]
  pushSubscriptions PushSubscription[]
  mfaChallenges   MfaChallenge[]
  mfaRecoveryCodes MfaRecoveryCode[]
  passwordResetTokens PasswordResetToken[]
  billingSubscription BillingSubscription?
  billingEntries BillingLedgerEntry[]
  billingPixInvoices BillingPixInvoice[]
  productFeedback ProductFeedback[]
  productFeedbackVotes ProductFeedbackVote[]

  @@index([accountStatus, createdAt(sort: Desc)])
  @@map("users")
}

model PendingSignup {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  name         String   @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  storeSlug    String   @map("store_slug") @db.VarChar(80)
  tokenHash    String   @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  emailSentAt  DateTime? @map("email_sent_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("pending_signups")
}

model Store {
  id        String        @id @default(uuid()) @db.Uuid
  publicId  String        @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  name      String        @db.VarChar(120)
  slug      String        @unique @db.VarChar(80)
  timezone  String        @default("America/Sao_Paulo") @db.VarChar(64)
  active    Boolean       @default(true)
  profile   Json?
  profileEncrypted String? @map("profile_encrypted") @db.Text
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  members   StoreMember[]
  auditLogs AuditLog[]
  products  Product[]
  shopifyCollections ShopifyCollection[]
  checkouts Checkout[]
  shopifyConnection ShopifyConnection?
  shopifyOAuthStates ShopifyOAuthState[]
  shippingMethods ShippingMethod[]
  gatewayConnections GatewayConnection[]
  customDomain StoreDomain?
  coupons Coupon[]
  notificationStates NotificationState[]
  deliveryJobs IntegrationDeliveryJob[]
  mediaAssets MediaAsset[]
  abandonedRecoverySettings AbandonedRecoverySettings?
  abandonedRecoveryDeliveries AbandonedRecoveryDelivery[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  productFeedback ProductFeedback[]
  chromaSenseSessions ChromaSenseSession[]

  @@map("stores")
}

model ProductFeedback {
  id          String                @id @default(uuid()) @db.Uuid
  publicId    String                @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  userId      String                @map("user_id") @db.Uuid
  storeId     String?               @map("store_id") @db.Uuid
  type        ProductFeedbackType   @default(SUGGESTION)
  status      ProductFeedbackStatus @default(BACKLOG)
  approved    Boolean               @default(false)
  title       String                @db.VarChar(120)
  description String                @db.Text
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store       Store?                @relation(fields: [storeId], references: [id], onDelete: SetNull)
  votes       ProductFeedbackVote[]

  @@index([approved, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("product_feedback")
}

model ProductFeedbackVote {
  id         String          @id @default(uuid()) @db.Uuid
  feedbackId String          @map("feedback_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  feedback   ProductFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
  @@index([userId])
  @@map("product_feedback_votes")
}

model ProductRelease {
  id          String                 @id @default(uuid()) @db.Uuid
  publicId    String                 @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  category    ProductReleaseCategory @default(NEWS)
  title       String                 @db.VarChar(140)
  description String                 @db.Text
  imageUrl    String?                @map("image_url") @db.VarChar(2048)
  videoUrl    String?                @map("video_url") @db.VarChar(2048)
  published   Boolean                @default(true)
  publishedAt DateTime               @default(now()) @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([published, publishedAt(sort: Desc)])
  @@map("product_releases")
}

model IntegrationCatalogAsset {
  id             String   @id @default(uuid()) @db.Uuid
  integrationKey String   @unique @map("integration_key") @db.VarChar(64)
  imageUrl       String   @map("image_url") @db.VarChar(2048)
  altText        String   @default("") @map("alt_text") @db.VarChar(160)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("integration_catalog_assets")
}

model WebhookEndpoint {
  id              String            @id @default(uuid()) @db.Uuid
  publicId        String            @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  storeId         String            @map("store_id") @db.Uuid
  name            String            @db.VarChar(120)
  description     String?           @db.VarChar(240)
  url             String            @db.VarChar(2048)
  secretEncrypted String            @map("secret_encrypted") @db.Text
  active          Boolean           @default(true)
  events          String[]
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([storeId, active, createdAt(sort: Desc)])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String          @id @default(uuid()) @db.Uuid
  publicId          String          @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  storeId           String          @map("store_id") @db.Uuid
  webhookEndpointId String          @map("webhook_endpoint_id") @db.Uuid
  event             String          @db.VarChar(64)
  eventId           String          @map("event_id") @db.VarChar(64)
  payload           Json
  status            DeliveryJobStatus @default(PENDING)
  attempts          Int             @default(0)
  nextAttemptAt     DateTime?       @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt         DateTime?       @map("claimed_at") @db.Timestamptz(3)
  deliveredAt       DateTime?       @map("delivered_at") @db.Timestamptz(3)
  statusCode        Int?            @map("status_code")
  success           Boolean         @default(false)
  durationMs        Int?            @map("duration_ms")
  error             String?         @db.VarChar(500)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId, createdAt(sort: Desc)])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt, claimedAt])
  @@unique([webhookEndpointId, eventId])
  @@map("webhook_deliveries")
}

model StoreDomain {
  id            String    @id @default(uuid()) @db.Uuid
  publicId      String    @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  storeId       String    @unique @map("store_id") @db.Uuid
  hostname      String    @unique @db.VarChar(253)
  status        String    @default("PENDING_DNS") @db.VarChar(24)
  dokployDomainId String? @unique @map("dokploy_domain_id") @db.VarChar(128)
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(3)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(3)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("store_domains")
}

model Product {
  id                  String        @id @default(uuid()) @db.Uuid
  publicId            String        @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  storeId             String        @map("store_id") @db.Uuid
  source              ProductSource @default(MANUAL)
  sourceExternalId    String?       @map("source_external_id") @db.VarChar(128)
  sourceTitle         String        @map("source_title") @db.VarChar(240)
  checkoutTitle       String        @map("checkout_title") @db.VarChar(240)
  checkoutDescription String?       @map("checkout_description") @db.Text
  sourceDescriptionHtml String?     @map("source_description_html") @db.Text
  handle              String?       @db.VarChar(255)
  vendor              String?       @db.VarChar(255)
  productType         String?       @map("product_type") @db.VarChar(255)
  tags                String[]      @default([])
  sourceStatus        String?       @map("source_status") @db.VarChar(32)
  sourceUpdatedAt     DateTime?     @map("source_updated_at") @db.Timestamptz(3)
  syncedAt            DateTime?     @map("synced_at") @db.Timestamptz(3)
  fulfillmentType     String        @default("PHYSICAL") @map("fulfillment_type") @db.VarChar(16)
  externalDeliveryUrl String?       @map("external_delivery_url") @db.VarChar(2048)
  imageUrl            String?       @map("image_url") @db.VarChar(2048)
  priceCents          Int           @map("price_cents")
  compareAtCents      Int?          @map("compare_at_cents")
  stockQuantity       Int?          @map("stock_quantity")
  trackInventory      Boolean       @default(false) @map("track_inventory")
  maxPerOrder         Int           @default(10) @map("max_per_order")
  active              Boolean       @default(true)
  archivedAt          DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  store               Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  checkouts           Checkout[]
  variants            ProductVariant[]
  images              ProductImage[]
  collections         ProductCollection[]
  checkoutSessionItems CheckoutSessionItem[]

  @@unique([storeId, source, sourceExternalId])
  @@index([storeId, active, createdAt(sort: Desc)])
  @@map("products")
}

model ProductVariant {
  id               String   @id @default(uuid()) @db.Uuid
  publicId         String   @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  productId        String   @map("product_id") @db.Uuid
  sourceExternalId String   @map("source_external_id") @db.VarChar(128)
  title            String   @db.VarChar(240)
  sku              String?  @db.VarChar(255)
  barcode          String?  @db.VarChar(255)
  priceCents       Int      @map("price_cents")
  compareAtCents   Int?     @map("compare_at_cents")
  inventoryQuantity Int?    @map("inventory_quantity")
  availableForSale Boolean  @default(true) @map("available_for_sale")
  imageUrl         String?  @map("image_url") @db.VarChar(2048)
  selectedOptions  Json     @default("[]") @map("selected_options")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  checkoutSessions CheckoutSession[]
  checkoutSessionItems CheckoutSessionItem[]

  @@unique([productId, sourceExternalId])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  sourceExternalId String   @map("source_external_id") @db.VarChar(128)
  url              String   @db.VarChar(2048)
  altText          String?  @map("alt_text") @db.VarChar(512)
  width            Int?
  height           Int?
  position         Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sourceExternalId])
  @@index([productId, position])
  @@map("product_images")
}

model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String?  @map("store_id") @db.Uuid
  filename  String   @unique @db.VarChar(64)
  content   Bytes
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("media_assets")
}

model ShopifyCollection {
  id               String   @id @default(uuid()) @db.Uuid
  publicId         String   @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  storeId          String   @map("store_id") @db.Uuid
  sourceExternalId String   @map("source_external_id") @db.VarChar(128)
  title            String   @db.VarChar(240)
  handle           String   @db.VarChar(255)
  descriptionHtml  String?  @map("description_html") @db.Text
  imageUrl         String?  @map("image_url") @db.VarChar(2048)
  sourceUpdatedAt  DateTime? @map("source_updated_at") @db.Timestamptz(3)
  syncedAt         DateTime @map("synced_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products         ProductCollection[]

  @@unique([storeId, sourceExternalId])
  @@index([storeId, title])
  @@map("shopify_collections")
}

model ProductCollection {
  productId    String @map("product_id") @db.Uuid
  collectionId String @map("collection_id") @db.Uuid
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   ShopifyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
  @@map("product_collections")
}

model Checkout {
  id          String         @id @default(uuid()) @db.Uuid
  publicId    String         @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  storeId     String         @map("store_id") @db.Uuid
  productId   String         @map("product_id") @db.Uuid
  name        String         @db.VarChar(120)
  slug        String         @db.VarChar(80)
  status      CheckoutStatus @default(DRAFT)
  draftConfig Json           @default("{}") @map("draft_config")
  publishedConfig Json       @default("{}") @map("published_config")
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(3)
  archivedAt  DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  sessions    CheckoutSession[]
  chromaSenseSessions ChromaSenseSession[]

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([storeId, productId])
  @@index([storeId, archivedAt])
  @@map("checkouts")
}

model CheckoutSession {
  id                String                @id @default(uuid()) @db.Uuid
  publicId          String                @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  tokenHash         String                @unique @map("token_hash") @db.Char(64)
  checkoutId        String                @map("checkout_id") @db.Uuid
  variantId         String?               @map("variant_id") @db.Uuid
  quantity          Int
  unitPriceCents    Int                   @map("unit_price_cents")
  totalCents        Int                   @map("total_cents")
  couponId          String?               @map("coupon_id") @db.Uuid
  couponCode        String?               @map("coupon_code") @db.VarChar(40)
  discountCents     Int                   @default(0) @map("discount_cents")
  currency          String                @default("BRL") @db.Char(3)
  status            CheckoutSessionStatus @default(OPEN)
  source             String                @default("DIRECT") @db.VarChar(32)
  sourceCartId       String?               @map("source_cart_id") @db.VarChar(255)
  trackingParameters Json                  @default("{}") @map("tracking_parameters")
  customerDataEncrypted String?            @map("customer_data_encrypted") @db.Text
  customerEmailHash  String?               @map("customer_email_hash") @db.Char(64)
  customerDocumentHash String?             @map("customer_document_hash") @db.Char(64)
  shippingAddressEncrypted String?         @map("shipping_address_encrypted") @db.Text
  customerCapturedAt DateTime?             @map("customer_captured_at") @db.Timestamptz(3)
  shippingCapturedAt DateTime?             @map("shipping_captured_at") @db.Timestamptz(3)
  shippingMethodPublicId String?           @map("shipping_method_public_id") @db.VarChar(32)
  shippingMethodName String?               @map("shipping_method_name") @db.VarChar(120)
  shippingPriceCents Int                   @default(0) @map("shipping_price_cents")
  shippingMinDays   Int?                   @map("shipping_min_days")
  shippingMaxDays   Int?                   @map("shipping_max_days")
  expiresAt         DateTime              @map("expires_at") @db.Timestamptz(3)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(3)
  shopifyOrderId    String?               @unique @map("shopify_order_id") @db.VarChar(128)
  shopifyOrderName  String?               @map("shopify_order_name") @db.VarChar(120)
  shopifySyncStatus String?               @map("shopify_sync_status") @db.VarChar(16)
  shopifySyncStartedAt DateTime?          @map("shopify_sync_started_at") @db.Timestamptz(3)
  shopifySyncedAt   DateTime?             @map("shopify_synced_at") @db.Timestamptz(3)
  shopifySyncError  String?               @map("shopify_sync_error") @db.VarChar(500)
  confirmationEmailSentAt DateTime?        @map("confirmation_email_sent_at") @db.Timestamptz(3)
  confirmationEmailClaimedAt DateTime?     @map("confirmation_email_claimed_at") @db.Timestamptz(3)
  confirmationEmailNextAttemptAt DateTime? @map("confirmation_email_next_attempt_at") @db.Timestamptz(3)
  confirmationEmailAttempts Int            @default(0) @map("confirmation_email_attempts")
  confirmationEmailLastError String?       @map("confirmation_email_last_error") @db.VarChar(500)
  merchantEmailSentAt DateTime?            @map("merchant_email_sent_at") @db.Timestamptz(3)
  merchantEmailClaimedAt DateTime?         @map("merchant_email_claimed_at") @db.Timestamptz(3)
  merchantEmailNextAttemptAt DateTime?     @map("merchant_email_next_attempt_at") @db.Timestamptz(3)
  merchantEmailAttempts Int                @default(0) @map("merchant_email_attempts")
  merchantEmailLastError String?           @map("merchant_email_last_error") @db.VarChar(500)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  checkout          Checkout              @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  variant           ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  items             CheckoutSessionItem[]
  paymentAttempts   PaymentAttempt[]
  deliveryJobs      IntegrationDeliveryJob[]
  abandonedRecoveryDeliveries AbandonedRecoveryDelivery[]
  coupon            Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  chromaSenseSessions ChromaSenseSession[]

  @@index([checkoutId, status, expiresAt])
  @@index([checkoutId, createdAt(sort: Desc)])
  @@index([checkoutId, updatedAt(sort: Desc)])
  @@index([expiresAt])
  @@index([customerEmailHash])
  @@index([shopifySyncStatus, shopifySyncStartedAt])
  @@index([status, confirmationEmailSentAt, confirmationEmailNextAttemptAt])
  @@index([status, merchantEmailSentAt, merchantEmailNextAttemptAt])
  @@map("checkout_sessions")
}

model ChromaSenseSession {
  id                String          @id @default(uuid()) @db.Uuid
  publicId          String          @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  storeId           String          @map("store_id") @db.Uuid
