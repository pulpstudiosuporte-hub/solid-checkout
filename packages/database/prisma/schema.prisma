generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum StoreRole {
  OWNER
  ADMIN
  ANALYST
}

enum AuditActorType {
  USER
  SYSTEM
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  publicId        String        @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  email           String        @unique @db.VarChar(320)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  name            String        @db.VarChar(120)
  passwordHash    String?       @map("password_hash") @db.VarChar(255)
  disabledAt      DateTime?     @map("disabled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships     StoreMember[]
  sessions        Session[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Store {
  id        String        @id @default(uuid()) @db.Uuid
  publicId  String        @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  name      String        @db.VarChar(120)
  slug      String        @unique @db.VarChar(80)
  timezone  String        @default("America/Sao_Paulo") @db.VarChar(64)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  members   StoreMember[]
  auditLogs AuditLog[]

  @@map("stores")
}

model StoreMember {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      StoreRole
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSessions Session[]

  @@unique([storeId, userId])
  @@index([userId])
  @@index([storeId, role])
  @@map("store_members")
}

model Session {
  id              String   @id @default(uuid()) @db.Uuid
  tokenHash       String   @unique @map("token_hash") @db.Char(64)
  csrfTokenHash   String   @map("csrf_token_hash") @db.Char(64)
  userId          String   @map("user_id") @db.Uuid
  activeStoreId   String?  @map("active_store_id") @db.Uuid
  ipHash          String?  @map("ip_hash") @db.Char(64)
  userAgent       String?  @map("user_agent") @db.VarChar(512)
  lastSeenAt      DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership StoreMember? @relation(fields: [activeStoreId, userId], references: [storeId, userId], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          BigInt         @id @default(autoincrement())
  storeId     String?        @map("store_id") @db.Uuid
  actorUserId String?        @map("actor_user_id") @db.Uuid
  actorType   AuditActorType @map("actor_type")
  action      String         @db.VarChar(120)
  targetType  String?        @map("target_type") @db.VarChar(80)
  targetId    String?        @map("target_id") @db.VarChar(128)
  requestId   String?        @map("request_id") @db.VarChar(128)
  ipHash      String?        @map("ip_hash") @db.Char(64)
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  store       Store?         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
