# Nunca use valores reais neste arquivo.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3333
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Serão habilitados nas próximas etapas.
DATABASE_URL=postgresql://solid:local-development-only@127.0.0.1:5432/solid_dev
REDIS_URL=redis://127.0.0.1:6379
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# URL publica da API incorporada ao build do Vite.
VITE_API_URL=http://127.0.0.1:3333
