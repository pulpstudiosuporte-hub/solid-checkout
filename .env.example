# Nunca use valores reais neste arquivo.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3333
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Serão habilitados nas próximas etapas.
DATABASE_URL=postgresql://solid:local-development-only@127.0.0.1:5432/solid_dev
REDIS_URL=redis://127.0.0.1:6379
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://127.0.0.1:3333
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://127.0.0.1:3333/integrations/shopify/callback
SHOPIFY_SCOPES=read_products,write_orders

# Cobrança da plataforma: crie três preços mensais recorrentes no Stripe.
# O plano Start deve usar um preço recorrente de R$ 0 e coletar cartão mesmo assim.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_PRIME=
STRIPE_PRICE_ELITE=

# Cloudflare Turnstile. A chave secreta fica apenas na API e a chave publica
# entra no build do frontend. Se vazias, o desafio fica desativado localmente.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# URL publica da API incorporada ao build do Vite.
VITE_API_URL=http://127.0.0.1:3333
